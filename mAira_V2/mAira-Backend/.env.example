# ==============================================================================
# MAIRA PHASE 1 BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS
# ==============================================================================

# Application Environment: development | staging | production
ENVIRONMENT=development
APP_NAME=MAira
LOG_LEVEL=INFO

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mira_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_SCHEMA=sch_con

# JWT & Session Security Configuration
# JWT_SECRET_KEY must be a cryptographically strong random key of at least 32 bytes (256 bits)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_of_at_least_32_bytes_length
JWT_ALGORITHM=HS256
JWT_ISSUER=maira-backend
JWT_AUDIENCE=maira-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Registration & OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
REGISTRATION_TICKET_EXPIRE_MINUTES=10

# MFA Configuration
MFA_ENABLED=true
MFA_EXPIRY_MINUTES=5

# Email & Notification Service
# Options: mock | console | smtp | sendgrid | ses
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_USERNAME=your_smtp_username@example.com
EMAIL_PASSWORD=your_smtp_password_or_app_password
EMAIL_FROM_ADDRESS=noreply@maira.institution.edu
EMAIL_FROM_NAME=MAira Institutional Support
ALLOWED_EMAIL_DOMAINS_RAW=institution.edu

# Gen AI Microservice Integration
# The independently deployed local LLM / RAG service
GENAI_BASE_URL=http://127.0.0.1:8001
GENAI_SERVICE_SECRET=internal_shared_service_auth_token_here
GENAI_CONNECT_TIMEOUT_SECONDS=5.0
GENAI_READ_TIMEOUT_SECONDS=30.0
GENAI_MAX_RETRIES=2

# Security & CORS Controls
CORS_ALLOW_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

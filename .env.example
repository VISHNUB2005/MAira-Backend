# Copy to .env and fill in real values. NEVER commit .env (only this example file).
# There are no default credentials and no default JWT key: missing values stop the app at startup.

# ---- General ----
APP_NAME=MAira
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# ---- JWT (generate: python -m xsc_lib.xsc_lib_app.xsc_lib_a_secrets). The placeholder below is rejected. ----
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- OTP (generation and verification belong to Group 3) ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ---- Registration (the domain policy is enforced by Group 1, not by the email service) ----
ALLOWED_EMAIL_DOMAINS=your-organization.example

# ---- Email provider: smtp | mock | console | file ----
# console / file / mock work ONLY when ENVIRONMENT is development or test.
#   console = print the email (with the code) in the terminal
#   file    = save the email as outbox/latest.html (open it in a browser)
#   mock    = keep emails in memory (automated tests)
# SES and SendGrid are NOT supported in this phase.
EMAIL_PROVIDER=console
EMAIL_OUTBOX_DIR=outbox

# ---- SMTP (required when EMAIL_PROVIDER=smtp; all values come from your approved provider) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MAira
EMAIL_TLS_MODE=starttls          # starttls (587) | ssl (465) | none (development/test only)
EMAIL_TIMEOUT_SECONDS=15

# ---- Optional: read a secret from a file instead of the environment (Docker/Kubernetes style) ----
# EMAIL_PASSWORD_FILE=/run/secrets/email_password
# Optional: load secrets from one AWS Secrets Manager JSON secret (needs boto3)
# AWS_SECRETS_NAME=
